# ============================================
# 1ne.ai Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ============================================
# Database Configuration (REQUIRED)
# ============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://user:password@localhost:5432/1ne_db

# ============================================
# Application Settings
# ============================================
# Environment: dev, staging, prod
ENVIRONMENT=dev

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Require TOTP MFA for super_admin login and /admin APIs (recommended true in prod)
REQUIRE_SUPER_ADMIN_MFA=false

# ============================================
# Pipeline Test Script Configuration
# ============================================
# Used by: python test_pipeline.py --pdf <file>
API_BASE_URL=http://127.0.0.1:8000
API_EMAIL=admin@example.com
API_PASSWORD=change-me
# Optional: if set, login call is skipped
API_TOKEN=
# Optional: if set, this pack is used directly
API_PACK_ID=
PIPELINE_FORCE_OCR=true
PIPELINE_TIMEOUT_SECONDS=300
PIPELINE_POLL_INTERVAL_SECONDS=3
PIPELINE_REQUEST_TIMEOUT_SECONDS=30
PIPELINE_REPORT_PATH=pipeline_result.json

# ============================================
# LLM Provider API Keys (OPTIONAL)
# ============================================
# Only required if USE_REAL_LLM=true
# Get your API keys from:
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/
# - Google: https://makersuite.google.com/app/apikey

OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# ============================================
# LLM Feature Flags
# ============================================
# Set to true to use real LLM for template execution (better response quality).
# Requires at least one provider API key (OPENAI_API_KEY, ANTHROPIC_API_KEY, or GOOGLE_API_KEY).
USE_REAL_LLM=true

# Learning Hub: gap worker + background inventory expansion (can spend tokens).
# When false (recommended for dev): no gap worker loop, no inventory job enqueue, no gap job processing —
# Learning Hub HTTP routes stay DB/rules-only; POST /learning-hub/bootstrap-retry returns disabled.
LEARNING_HUB_AUTO_LLM_ENABLED=false

# Master switch for ANY outbound paid LLM call (chat completions, agents, etc.).
# When false: ModelRouter uses FallbackProvider only; template execution uses stubs even if USE_REAL_LLM=true;
# PixGen refuses to call the API (use stubs instead).
# Recommended for local dev and CI so misconfiguration cannot burn tokens.
LLM_OUTBOUND_ENABLED=false

# Safety lock: reserve OPENAI_API_KEY for ingestion embeddings only.
# With true, OpenAI chat/template/pixgen paths are blocked in code.
OPENAI_EMBEDDINGS_ONLY_MODE=true

# Embedding-specific outbound switch.
# Keep true when you want embeddings-only OpenAI usage while LLM_OUTBOUND_ENABLED=false.
EMBEDDING_OUTBOUND_ENABLED=true

# OCR-only embedding override:
# - Keep LLM_OUTBOUND_ENABLED=false to block chatbot/templates/pixgen outbound calls.
# - Set EMBEDDING_PROVIDER=openai to use OpenAI vectors in content ingestion.
# - With OCR_EMBEDDINGS_ONLY=true, only OCR-processed documents use OpenAI embeddings.
OCR_OPENAI_EMBEDDINGS_ENABLED=false
OCR_EMBEDDINGS_ONLY=true

# Enable fallback to FallbackProvider if all providers fail
FALLBACK_ENABLED=true

# ============================================
# LLM Default Configuration
# ============================================
# Default provider: openai, anthropic, google
DEFAULT_MODEL_PROVIDER=openai

# Default model name (must be supported by the provider)
DEFAULT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Default temperature (0.0 to 2.0, higher = more creative)
DEFAULT_TEMPERATURE=0.7

# Default maximum tokens in response (4000 recommended for lesson plans)
DEFAULT_MAX_TOKENS=4000

# ============================================
# Caching Configuration (OPTIONAL)
# ============================================
# Enable response caching to reduce API calls
CACHE_ENABLED=true

# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL_SECONDS=3600

# Redis URL for distributed caching (optional)
# If not set, uses in-memory cache
# Format: redis://host:port/db or redis://:password@host:port/db
REDIS_URL=

# ============================================
# Rate Limiting Configuration (OPTIONAL)
# ============================================
# Enable rate limiting to prevent API abuse
RATE_LIMIT_ENABLED=true

# Rate limits per provider (requests per minute)
OPENAI_RATE_LIMIT_RPM=60
ANTHROPIC_RATE_LIMIT_RPM=60
GOOGLE_RATE_LIMIT_RPM=60

# Optional global token limit per minute (not currently used)
TOKENS_PER_MINUTE=

# ============================================
# Cost Tracking Configuration (OPTIONAL)
# ============================================
# Enable cost tracking for LLM API calls
COST_TRACKING_ENABLED=true

# Custom model pricing override (optional, JSON format)
# If not set, uses default pricing from app/llm/config.py
# MODEL_PRICING={"openai": {"gpt-4o": {"input": 0.0025, "output": 0.010}}}

# ============================================
# OCR & Content Ingestion (local by default)
# ============================================
# OCR_MODE: local = never call external APIs; api = allow API engines if keys present
OCR_MODE=local

# Default engine when pack has ocr_policy=auto
# (tesseract | easyocr | mathpix | google_document_ai)
OCR_ENGINE_DEFAULT=tesseract

# Fallback when API keys missing or OCR_MODE=local with API engine
OCR_FALLBACK_ENGINE=tesseract

# Legacy: primary OCR engine
# (tesseract | easyocr | mathpix | google_document_ai)
OCR_ENGINE=tesseract

# API OCR runtime controls
OCR_API_TIMEOUT_SECONDS=90
OCR_API_MAX_RETRIES=2
OCR_API_RETRY_BACKOFF_SECONDS=5,15,30,60
OCR_ASYNC_BATCH_MIN_FILE_MB=10
OCR_ASYNC_BATCH_MIN_PAGES=20
OCR_ASYNC_BATCH_TIMEOUT_SECONDS=900
OCR_ASYNC_BATCH_POLL_SECONDS=5
OCR_MAX_UPLOAD_SIZE_MB_HARD=100
DOCUMENT_AI_GCS_BUCKET=
DOCUMENT_AI_GCS_PREFIX=documentai

# Google Document AI (required when OCR_ENGINE_DEFAULT=google_document_ai)
DOCUMENT_AI_PROJECT_ID=
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=
# Use a local, non-committed service-account path:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Below this avg chars per page, document is treated as scanned and OCR runs
SCANNED_THRESHOLD_CHARS=50

# Chunking profiles
# Digital documents (standard PDFs with text layer)
CHUNK_SIZE_TOKENS_DIGITAL=500
CHUNK_OVERLAP_TOKENS_DIGITAL=50
# OCR / scanned documents (smaller chunks for better coverage; target 200–250)
CHUNK_SIZE_TOKENS_OCR=220
CHUNK_OVERLAP_TOKENS_OCR=50
# Minimum chunks required for OCR docs before adaptive rechunking kicks in
OCR_MIN_CHUNKS_THRESHOLD=20
# For small OCR docs (pages < OCR_MIN_PAGES_FOR_THRESHOLD): use lower threshold
OCR_MIN_PAGES_FOR_THRESHOLD=30
OCR_MIN_CHUNKS_THRESHOLD_SMALL=10
# Deterministic rechunk size when below threshold (no guesswork)
OCR_RECHUNK_SIZE_TOKENS=200

# Role-bucket retrieval: minimum chunks per bucket before backfill
BUCKET_MIN_TARGET=4
# Role tagging: min chars for exercise/exam blocks (anti false-positive)
ROLE_MIN_CHARS_FOR_QUESTION_BLOCK=200

# Optional: Tesseract binary path (Windows: C:\Program Files\Tesseract-OCR\tesseract.exe)
# TESSERACT_CMD=

# Optional: Poppler path for pdf2image (Windows: e.g. C:\poppler\Library\bin)
# POPPLER_PATH=
